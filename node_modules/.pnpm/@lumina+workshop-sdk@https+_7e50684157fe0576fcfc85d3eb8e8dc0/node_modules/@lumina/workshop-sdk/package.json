{
  "name": "@lumina/workshop-sdk",
  "version": "1.0.2",
  "description": "Public SDK contracts for Lumina Studio Creative Workshop modules",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumina-layer-studio/Lumina-Workshop-SDK.git"
  },
  "homepage": "https://github.com/lumina-layer-studio/Lumina-Workshop-SDK#readme",
  "bugs": {
    "url": "https://github.com/lumina-layer-studio/Lumina-Workshop-SDK/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "pack:release": "pnpm run test && pnpm pack --pack-destination dist-package"
  }
}